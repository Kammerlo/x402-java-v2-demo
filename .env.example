# Cardano preprod. Free Blockfrost key: https://blockfrost.io (choose "Cardano preprod").
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXX

# The seller's address: where payments go (any preprod address you own).
PAY_TO=addr_test1...

# The buyer: a 24-word preprod wallet with a few tADA (faucet: https://docs.cardano.org/cardano-testnets/tools/faucet).
BUYER_MNEMONIC=word1 word2 ... word24

# Optional: the key the server sends to the facilitator's /verify and /settle (default demo-secret).
# FACILITATOR_API_KEY=
